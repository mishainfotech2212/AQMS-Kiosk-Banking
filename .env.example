# Required — copy from Supabase Dashboard → Project Settings → API → anon public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — defaults to the project Edge Functions base URL in app config.
# Set this in Netlify environment variables instead of committing a real URL.
# EXPO_PUBLIC_API_BASE_URL=REPLACE_WITH_YOUR_API_BASE_URL

# After editing .env, restart Metro with a clean cache:
# npx expo start -c
